# Public base URL of the site, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
# Local: http://localhost:3000 · Vercel: https://your-domain.mn (set for Production and Preview)
NEXT_PUBLIC_SITE_URL=

# Supabase API URL. Local: "API URL" from `npx supabase status` · Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_…). Safe in the browser: row level security applies.
# Local: "Publishable key" from `npx supabase status` · Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_…), acts as the service role and BYPASSES row level security.
# Server only: never prefix it with NEXT_PUBLIC_ and never expose it to the browser.
# Local: "Secret key" from `npx supabase status` · Hosted: Project Settings → API Keys.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile: the spam check on the public forms and on the staff sign-in and password
# reset (dash.cloudflare.com → Turnstile → add the site's domain). The site key is public; the
# secret key stays on the server. Locally, Cloudflare's test keys always pass:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret salt for hashing visitor IP addresses (form and sign-in limits); the IP itself is never
# stored. Any long random string, e.g. `openssl rand -hex 32`. Changing it resets the limits.
IP_HASH_SALT=

# Resend API key (resend.com → API Keys). Without it, form submissions are still saved and shown in
# /admin/inbox, but no email goes out.
RESEND_API_KEY=

# Who gets an email for every new form submission. Until a domain is verified in Resend, emails are
# sent from onboarding@resend.dev, which only delivers to the Resend account's own address, so
# NOTIFY_EMAIL must be that address.
NOTIFY_EMAIL=

# Optional. Sender once a domain is verified in Resend, e.g. "НЭР <noreply@your-domain.mn>".
# Default: onboarding@resend.dev.
EMAIL_FROM=

# Optional. Facebook app ID (developers.facebook.com → My Apps), needed for the Messenger share
# button on computers (Facebook "send" dialog) and added to every page as fb:app_id. Without it
# the Messenger button shows on phones only.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Optional, Vercel only. "1" turns on Vercel Web Analytics (page views) and Speed Insights (Core
# Web Vitals from real visitors); enable each in the Vercel project first (Analytics / Speed
# Insights tabs; both have a free tier). Leave empty locally. Read at build time: redeploy after
# changing them.
VERCEL_ANALYTICS=
VERCEL_SPEED_INSIGHTS=

# Only for scripts/create-admin.ts (creates the first admin). Not used by the app and not needed on
# Vercel. Prefer setting them in the shell for that one command instead of keeping a password here.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
